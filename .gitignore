# dependencies (devDependencies exist only for the preview harness)
node_modules/

# Official mascot artwork. Deliberately NOT committed: it is game art owned by
# Hypergryph (Arknights) and Bushiroad (BanG Dream!). `npm run fetch-art`
# downloads it from art/looks.json into this folder on your own machine.
# art/looks.json (the declaration) and art/index.json (the generated index) ARE
# committed, so the plugin knows what to look for without running anything.
art/*.png
art/*.webp
art/*.jpg
art/*.jpeg
art/*.gif

# 例外：角色背景图。由仓库所有者指定随仓库分发 —— 见 COPYRIGHT.md 第 2 节。
# 除此之外 art/ 下的任何图片仍然一律不提交，`npm test` 会盯着这件事。
!art/room-*.png
!art/room-*.webp
!art/room-*.jpg
!art/room-*.jpeg

# Generated by scripts/preview.mjs. The vector-art preview is committed; the
# `--official` one is not, for the same reason as art/ itself.
docs/preview.html
docs/preview-official.html
docs/preview-official.png

# editor / OS noise
.vscode/
.idea/
Thumbs.db
Desktop.ini
*.log

# Artwork copied next to the console by 
pm run art:publish. Ignored by default
# for the same reason as art/ itself, so it cannot be committed by accident.
# Committing it is a deliberate choice — see the note that script prints, and
# git add -f docs/art — and 
pm run build:site only advertises a local copy
# once it is actually tracked.
docs/art/

# Fetched on demand by 
pm run rig:reference: the Spine 3.8 runtime (Spine's, under
# the Spine Runtimes License) and a game model (Hypergryph's). Neither is
# redistributed, so neither is committed.
.cache/

# 官方 Spine 运行时与模型：只在量动作时下载到本机，不进仓库。
art/.motion-cache/

# 使用者自己放的配音文件。与 art/ 同理：进仓库的是约定与代码，音频留在本机。
voices/
